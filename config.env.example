# ==============================================================================
# Yamaha RX-Z1 Serial Controller - Configuration
# ==============================================================================
# Place this file in one of the following locations:
#   System-wide:  /etc/yamaha-serial/config.env
#   User space:   ~/.config/yamaha-serial/config.env
#   Local folder: ./config.env  or  ./.env
# ==============================================================================

# Operation Mode
# Set to 'false' when connecting to the physical Yamaha RX-Z1 receiver.
# Set to 'true' to run the offline simulator for testing without hardware.
MOCK_SERIAL=false

# Serial Port Settings
# Common Raspberry Pi USB serial paths: /dev/ttyUSB0, /dev/ttyAMA0, or custom symlink
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1.0

# HTTP and WebSocket Web Server Settings
# HOST=0.0.0.0 binds to all network interfaces on the Pi
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
