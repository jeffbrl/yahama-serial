[Unit]
Description=Yamaha RX-Z1 MQTT to REST Bridge
After=network.target yamaha-serial.service
Wants=yamaha-serial.service

[Service]
Type=simple
User=jeffl
ExecStart=/usr/local/bin/yamaha-mqtt-bridge.sh
Restart=always
RestartSec=5
Environment=MQTT_HOST=192.168.6.182
Environment=MQTT_PORT=1883
Environment=MQTT_USER=mqtt_user
Environment=MQTT_PASS=40356mqtt
Environment=API_URL=http://127.0.0.1:8000/api

[Install]
WantedBy=multi-user.target
