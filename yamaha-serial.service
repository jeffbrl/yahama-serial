[Unit]
Description=Yamaha RX-Z1 Serial Controller API & Web UI
After=network.target

[Service]
Type=simple
# Update User, WorkingDirectory, and ExecStart to match your environment:
# User=pi
# WorkingDirectory=/home/pi/development/yahama-serial
Environment="PYTHONPATH=src"
Environment="MOCK_SERIAL=false"
ExecStart=/path/to/yahama-serial/.venv/bin/python -m yamaha_serial.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

